(service_defaults) {
	encode zstd gzip
	header -Server
}

qbittorrent.{$PROXY_DOMAIN:media.home.arpa} {
	import service_defaults
	import tls_policy
	reverse_proxy gluetun:8080
}

sabnzbd.{$PROXY_DOMAIN:media.home.arpa} {
	import service_defaults
	import tls_policy
	reverse_proxy sabnzbd:8080
}

