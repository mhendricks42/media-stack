# Linux target
COMPOSE_PROJECT_NAME=media
COMPOSE_FILE=docker-compose.yml:compose/linux.yml
COMPOSE_PATH_SEPARATOR=:

# Host bind and restart behavior
BIND_ADDR=0.0.0.0
RESTART_POLICY=unless-stopped

# Runtime identity
PUID=1000
PGID=1000
TZ=America/New_York

# Data root (must be a single filesystem tree)
DATA_ROOT=/data

# NordVPN credentials are secrets. Set NORD_USER and NORD_PASS in your shell.
VPN_COUNTRY=United States

# LAN subnet for Gluetun firewall return traffic
LAN_SUBNET=192.168.1.0/24

# Tailscale auth key is a secret. Set TS_AUTHKEY in your shell.
TS_HOSTNAME=media-server
# Optional comma-separated routes to advertise
TS_ROUTES=
