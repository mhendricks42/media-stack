# Linux target
COMPOSE_PROJECT_NAME=media
COMPOSE_FILE=docker-compose.yml:compose/linux.yml:compose/secrets.yml
COMPOSE_PATH_SEPARATOR=:

# Host bind and restart behavior
BIND_ADDR=0.0.0.0
RESTART_POLICY=unless-stopped

# Runtime identity
PUID=1000
PGID=10
TZ=America/New_York

# Visible Jellyfin server name. Override per environment if desired.
JELLYFIN_SERVER_NAME=Media Stack

# Data root (must be a single filesystem tree)
DATA_ROOT=/data

# NordVPN credentials live in secrets/openvpn_user and secrets/openvpn_password.
# Create them with ./stack.sh init-vpn. Keep these legacy values blank.
VPN_USER=
VPN_PASS=
VPN_COUNTRY=United States
VPN_HOSTNAME=us12802.nordvpn.com

# Usenet provider credentials are secrets. Set SAB_SERVER_* values in your shell.
# Optional examples: SAB_SERVER_HOST=news.example.com, SAB_SERVER_PORT=563,
# SAB_SERVER_CONNECTIONS=20, SAB_BACKUP_SERVER_HOST=block.example.com.

# LAN subnet for Gluetun firewall return traffic
LAN_SUBNET=192.168.1.0/24

# Tailscale auth key is a secret. Set TS_AUTHKEY in your shell.
TS_HOSTNAME=media-server
# Optional comma-separated routes to advertise
TS_ROUTES=
