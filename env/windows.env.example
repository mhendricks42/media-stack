# Windows target
COMPOSE_PROJECT_NAME=media-dev
COMPOSE_FILE=docker-compose.yml;compose/windows.yml
COMPOSE_PATH_SEPARATOR=;
COMPOSE_PROFILES=tailscale

# Host bind and restart behavior
BIND_ADDR=127.0.0.1
RESTART_POLICY=no

# Runtime identity (read from inside WSL distro)
PUID=1000
PGID=1000
TZ=America/New_York

# Visible Jellyfin server name. Override per environment if desired.
JELLYFIN_SERVER_NAME=Media Stack Dev

# DATA_ROOT should be inside a real WSL distro or ext4 storage.
# Run .\stack.ps1 init-windows to set this for your machine.
DATA_ROOT=\\wsl$\Ubuntu\home\YOUR_WSL_USER\data

# NordVPN credentials are secrets. Set NORD_USER and NORD_PASS in your shell.
VPN_COUNTRY=United States

# Usenet provider credentials are secrets. Set SAB_SERVER_* values in your shell.
# Optional examples: SAB_SERVER_HOST=news.example.com, SAB_SERVER_PORT=563,
# SAB_SERVER_CONNECTIONS=20, SAB_BACKUP_SERVER_HOST=block.example.com.

# Windows local subnet for Gluetun firewall return traffic
LAN_SUBNET=192.168.1.0/24

# Optional Tailscale container node. Set TS_AUTHKEY in the shell, never here.
TS_HOSTNAME=media-dev-windows
